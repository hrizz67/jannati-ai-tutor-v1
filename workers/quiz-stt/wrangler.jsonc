{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jannati-ai-tutor-quiz-stt-pilot",
  "main": "src/index.js",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "QUIZ_DAILY_USAGE", "class_name": "QuizDailyUsageQuota" }
    ]
  },
  "exports": {
    "QuizDailyUsageQuota": { "type": "durable-object", "storage": "sqlite" }
  },
  "ratelimits": [
    {
      "name": "QUIZ_ACCOUNT_RATE_LIMITER",
      "namespace_id": "11011",
      "simple": { "limit": 4, "period": 60 }
    },
    {
      "name": "QUIZ_GLOBAL_RATE_LIMITER",
      "namespace_id": "11012",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "vars": {
    "QUIZ_STT_PILOT_ENABLED": "false",
    "QUIZ_STT_AUTH_DIAGNOSTICS_ENABLED": "false",
    "QUIZ_STT_ACCESS_MODE": "allowlist",
    "QUIZ_STT_CONSENT_NOTICE_VERSION": "quiz-stt-cloudflare-bm-v1",
    "QUIZ_STT_DAILY_MAX_INFERENCES": "100",
    "CORS_ALLOW_ORIGINS": "https://qa.invalid"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
