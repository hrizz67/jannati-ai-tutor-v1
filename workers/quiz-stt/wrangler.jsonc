{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jannati-ai-tutor-quiz-stt-pilot",
  "main": "src/index.js",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "QUIZ_ACCOUNT_RATE_LIMITER",
      "namespace_id": "11011",
      "simple": { "limit": 4, "period": 60 }
    },
    {
      "name": "QUIZ_GLOBAL_RATE_LIMITER",
      "namespace_id": "11012",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "vars": {
    "QUIZ_STT_PILOT_ENABLED": "false",
    "CORS_ALLOW_ORIGINS": "https://hrizz67.github.io"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
